[Unit]
Description=First Sunday of the month, 02:00: write AIREP social posts two months ahead

[Timer]
# 02:00 local (the box is AEST): the weekly Claude Code allowance is not in use by
# anyone else then. Persistent so a box asleep at 02:00 runs once on wake.
OnCalendar=Sun *-*-01..07 02:00:00
Persistent=true
AccuracySec=5m
Unit=airep-social-author@write.service

[Install]
WantedBy=timers.target
