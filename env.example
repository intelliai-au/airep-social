# Copy to ~/.config/airep-social/env and chmod 600 it. push.py --live refuses any
# other mode. Keiran fills this in with his hidden-prompt script; never paste values
# into chat, a commit or a log.

# Buffer API key (Buffer > Settings > API; the "AIREP" key of 2026-05-28 or a fresh one).
BUFFER_API_KEY=

# Channel ids of the Intelli AI LinkedIn Page and Facebook Page in Buffer.
# `push.py --channels` prints them once BUFFER_API_KEY is set.
BUFFER_LINKEDIN_CHANNEL_ID=
BUFFER_FACEBOOK_CHANNEL_ID=

# Astrid generic webhook (Telegram: /webhook create, source generic). The URL is
# https://nova-kjef.onrender.com/webhooks/<id>; the secret is optional but recommended.
ASTRID_WEBHOOK_URL=
ASTRID_WEBHOOK_SECRET=

# Where GitHub Pages serves this repo's site/ folder. Change only if the repo moves.
PAGES_BASE_URL=https://intelliai-au.github.io/airep-social/site/
